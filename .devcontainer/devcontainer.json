{
  "name": "Music Hit Prediction (FastAPI + Next.js)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/app/main.py",
        "frontend/app/page.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; sudo apt-get install -y ffmpeg; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; npm --prefix frontend install; echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "api": "uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "web": "npm --prefix frontend run dev -- --port 3000"
  },
  "portsAttributes": {
    "3000": {
      "label": "Frontend (Next.js)",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "API (FastAPI)",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [3000, 8000]
}
